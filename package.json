{
  "name": "di-ipv-core-front",
  "version": "0.0.1",
  "description": "User interface for the Identity Proofing and Verification (IPV) system within the GDS digital identity platform, GOV.UK Sign In.",
  "main": "src/app.ts",
  "engines": {
    "node": "24.x",
    "npm": ">=11"
  },
  "scripts": {
    "start": "node --enable-source-maps build/app.js",
    "start-dev": "ts-node src/app.ts | pino-pretty",
    "dev": "nodemon --exec \"node --inspect=0.0.0.0:9228 --require ts-node/register src/app.ts\" --ext js,ts,json",
    "build": "npm run build-js && npm run build-sass && npm run copy-images",
    "build-js": "mkdir -p dist/public/javascripts; uglifyjs node_modules/@govuk-one-login/frontend-analytics/lib/analytics.js assets/javascript/**/*.js -o dist/public/javascripts/application.js -c -m && cp node_modules/govuk-frontend/dist/govuk/govuk-frontend.min.js dist/public/javascripts/ && cp node_modules/@govuk-one-login/frontend-ui/build/esm/frontend/index.js dist/public/javascripts/frontend-ui.js && cp node_modules/@govuk-one-login/frontend-device-intelligence/build/esm/index.js dist/public/javascripts/fingerprint.js",
    "build-sass": "rm -rf dist/public/style.css && sass --no-source-map assets/scss/application.scss dist/public/stylesheets/application.css --style compressed",
    "build-service-unavailable": "mkdir -p dist/public/html && ts-node ./build-scripts/build-service-unavailable-html.ts dist/public/html/service-unavailable.html",
    "check-translations": "npx tsx locales/check-translations.ts",
    "watch-sass": "sass --no-source-map assets/scss/application.scss dist/public/stylesheets/application.css --style compressed --watch",
    "copy-images": "copyfiles -u 2 assets/images/** dist/public/images",
    "lint": "prettier --check src browser-tests/functional-tests browser-tests/data browser-tests/e2e-tests locales && eslint src/ browser-tests/functional-tests/ browser-tests/data/ browser-tests/e2e-tests",
    "lint-fix": "prettier --write src browser-tests/functional-tests browser-tests/data browser-tests/e2e-tests locales && eslint --fix src/ browser-tests/functional-tests/ browser-tests/data/ browser-tests/e2e-tests/",
    "test": "mocha",
    "test:coverage": "nyc --reporter=lcov --reporter=text-summary npm test",
    "test:watch": "mocha --watch",
    "tsc": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alphagov/di-ipv-core-front.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alphagov/di-ipv-core-front/issues"
  },
  "homepage": "https://github.com/alphagov/di-ipv-core-front#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chai": "4.3.20",
    "@types/chai-as-promised": "7.1.8",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/nunjucks": "3.2.6",
    "@types/overload-protection": "1.2.4",
    "@types/proxyquire": "1.3.31",
    "@types/qrcode": "1.5.6",
    "@types/sinon": "22.0.1",
    "@types/sinon-chai": "3.2.12",
    "@types/ua-parser-js": "0.7.39",
    "@types/uid-safe": "2.1.5",
    "chai": "4.5.0",
    "chai-as-promised": "7.1.2",
    "copyfiles": "2.4.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "mocha": "12.0.3",
    "nodemon": "3.1.14",
    "nyc": "18.0.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "proxyquire": "2.1.3",
    "sass": "1.106.1",
    "sinon": "22.1.0",
    "sinon-chai": "3.7.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.0",
    "uglify-js": "3.19.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1156.0",
    "@aws-sdk/client-ssm": "3.1156.0",
    "@govuk-one-login/data-vocab": "2.0.3",
    "@govuk-one-login/frontend-analytics": "4.2.3",
    "@govuk-one-login/frontend-device-intelligence": "1.2.0",
    "@govuk-one-login/frontend-passthrough-headers": "1.3.2",
    "@govuk-one-login/frontend-ui": "5.3.6",
    "@govuk-one-login/frontend-vital-signs": "0.1.4",
    "axios": "1.20.0",
    "body-parser": "2.4.0",
    "connect-dynamodb": "3.0.5",
    "cookie-parser": "1.4.7",
    "csrf-sync": "4.2.1",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "govuk-frontend": "6.6.0",
    "i18next": "26.5.6",
    "i18next-fs-backend": "2.6.9",
    "i18next-http-middleware": "3.9.9",
    "nunjucks": "3.2.4",
    "overload-protection": "1.2.3",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "sanitize-filename": "1.6.4",
    "ua-parser-js": "2.0.10"
  }
}
