{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.15.0/schemas/schema.json",
  "services": [
    {
      "product": "IPV-Core",
      "component": "ipv-core-front",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/automated-tests.yaml",
            "path": "$.jobs.detect-secrets"
          },
          "checks": [
            {
              "name": "secret scanning"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/automated-tests.yaml",
            "path": "$.jobs.run-tests"
          },
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "unit"
            },
            {
              "name": "unit test coverage"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/automated-tests.yaml",
            "path": "$.jobs.browser-tests"
          },
          "checks": [
            {
              "name": "new feature"
            },
            {
              "name": "regression"
            },
            {
              "name": "visual regression"
            }
          ]
        }
      ]
    }
  ]
}
