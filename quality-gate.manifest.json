{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.13.0/schemas/schema.json",
  "services": [
    {
      "product": "IPV-Core",
      "component": "ipv-core-front",
      "promotionType": "securePipelines",
      "checks": [
        {
          "checkTypes": [
            "secret scanning"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/automated-tests.yaml",
            "path": "$.jobs.detect-secrets"
          }
        },
        {
          "checkTypes": [
            "code style and linting",
            "unit",
            "unit test coverage"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/automated-tests.yaml",
            "path": "$.jobs.run-tests"
          }
        },
        {
          "checkTypes": [
            "new feature",
            "regression",
            "visual regression"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/automated-tests.yaml",
            "path": "$.jobs.browser-tests"
          }
        }
      ]
    }
  ]
}
