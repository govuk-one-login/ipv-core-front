{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.19.0/schemas/schema.json",
  "services": [
    {
      "product": "IPV-Core",
      "component": "ipv-core-front",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "secret scanning"
            }
          ],
          "file": ".github/workflows/automated-tests.yaml",
          "path": "$.jobs.detect-secrets"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/automated-tests.yaml",
          "path": "$.jobs.run-tests[?@.name=='Run lint']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit"
            },
            {
              "name": "unit test coverage"
            }
          ],
          "file": ".github/workflows/automated-tests.yaml",
          "path": "$.jobs.run-tests[?@.name=='Run test and write coverage']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/automated-tests.yaml",
          "path": "$.jobs.run-tests[?@.name=='Run sonar scan']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "visual regression"
            },
            {
              "name": "integration",
              "purpose": [
                "new feature",
                "regression"
              ]
            }
          ],
          "file": ".github/workflows/automated-tests.yaml",
          "path": "$.jobs.browser-tests"
        },
        {
          "phase": "pre-upload",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit"
            },
            {
              "name": "unit test coverage"
            }
          ],
          "file": ".github/workflows/automated-tests.yaml",
          "path": "$.jobs.run-tests[?@.name=='Run test and write coverage']"
        }
      ],
      "notApplicable": [
        {
          "checks": [
            {"name": "contract", "details": ["Not a Phase 1 API"]}
          ]
        }
      ]
    }
  ]
}
